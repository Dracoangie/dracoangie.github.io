---
import "../styles/global.css";
import { content, type Lang } from "../data/i18n";
interface Props { lang: Lang; }
const { lang } = Astro.props;
const { profile, ui } = content[lang];
const title = `${profile.name} — ${profile.role}`;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content={ui.description} />
    <meta name="theme-color" content="#21181b" />
    <link rel="icon" type="image/png" href={`${import.meta.env.BASE_URL}images/favicon.png`} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="alternate" hreflang="es" href={new URL(base, Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(`${base}en/`, Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(base, Astro.site)} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={ui.description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={new URL("fondo-portfolio.png", Astro.site)} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#contenido">{ui.skip}</a>
    <slot />
    <script>
      import "../scripts/interactions";
    </script>
  </body>
</html>
