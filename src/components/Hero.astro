---
import { ArrowDown } from "@lucide/astro";
import { content, type Lang } from "../data/i18n";
interface Props { lang: Lang; }
const { lang } = Astro.props;
const { ui } = content[lang];
---
<section class="hero" id="inicio" aria-labelledby="hero-title">
  <div class="hero-scene" aria-hidden="true">
    <img class="hero-layer hero-sky" src={`${import.meta.env.BASE_URL}hero-sky.png`} alt="" fetchpriority="high" width="1600" height="900" />
    <img class="hero-layer hero-clouds" src={`${import.meta.env.BASE_URL}hero-clouds.png`} alt="" fetchpriority="high" width="1600" height="900" />
    <img class="hero-layer hero-city" src={`${import.meta.env.BASE_URL}hero-city.png`} alt="" fetchpriority="high" width="1600" height="900" />
    <canvas class="hero-layer hero-character" data-character-sprite={`${import.meta.env.BASE_URL}hero-character-sprite.png`} width="1600" height="900" aria-hidden="true"></canvas>
  </div>
  <div class="hero-content">
    <p class="eyebrow hero-eyebrow"><span class="status-square"></span> {ui.heroLabel}</p>
    <h1 id="hero-title"><span>Portfolio<span class="name-dot">.</span></span></h1>
    <p class="hero-name">Ángela Navarro</p>
  </div>
  <div class="hero-bottom">
    <a class="scroll-link" href="#sobre-mi" aria-label={ui.scroll}><ArrowDown size={20} /></a>
  </div>
</section>
